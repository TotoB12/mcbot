{
	"schemaVersion": 1,
	"id": "mcbot",
	"version": "${version}",
	"name": "Helper Bot",
	"description": "This is an example description! Tell everyone what your mod is about!",
	"authors": [
		"TotoB12"
	],
	"contact": {
		"homepage": "https://totob12.com/",
		"sources": "https://github.com/TotoB12/mcbot"
	},
	"license": "CC0-1.0",
	"icon": "assets/modid/icon.png",
	"environment": "server",
	"entrypoints": {
		"server": [
            "com.antoninbeliard.HelperBot"
        ]
	},
	"mixins": [
		"modid.mixins.json",
		{
			"config": "modid.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.16.10",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"another-mod": "*"
	}
}